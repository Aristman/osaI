{
  "name": "osai",
  "version": "0.1.0",
  "private": true,
  "description": "Operation System AI — AI Operating System with autonomous agent",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --build tsconfig.build.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "os",
    "agent",
    "autonomous"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
