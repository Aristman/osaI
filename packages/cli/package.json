{
  "name": "@osai/cli",
  "version": "0.0.1",
  "description": "osaI CLI -- Interactive CLI + TUI (DOMAIN-011)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node ./bin/osai.js",
    "init": "node ./bin/osai.js init",
    "status": "node ./bin/osai.js status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "osai": "./bin/osai.js"
  },
  "dependencies": {
    "@osai/gateway": "workspace:*",
    "ink": "^5",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "ink-testing-library": "^4"
  }
}
