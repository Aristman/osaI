{
  "name": "@osai/gateway",
  "version": "0.0.1",
  "description": "osaI Gateway -- WebSocket Control Plane (DOMAIN-001)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node ./dist/start.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@osai/agent": "workspace:*",
    "@osai/providers": "workspace:*",
    "@osai/shared": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "grammy": "^1.41.1",
    "pino": "^10.3.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1"
  }
}
