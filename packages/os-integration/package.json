{
  "name": "@osai/os-integration",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osai/types": "0.0.1",
    "chokidar": "^4.0.3",
    "node-notifier": "^10.0.1",
    "systeminformation": "^5.25.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
